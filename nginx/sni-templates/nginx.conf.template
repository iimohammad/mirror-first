# ---------------------------------------------------------------------------
# پروکسی passthrough بر پایه SNI — کل فایل nginx.conf کانتینر sniproxy.
#
# چرا کل nginx.conf و نه یک فایل در conf.d؟ چون بلاک stream در سطح main
# تعریف می‌شود، و conf.d ایمیج رسمی از داخل http{} اینکلود می‌شود.
# (entrypoint با NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx این را روی
# /etc/nginx/nginx.conf می‌نویسد.)
#
# TLS اینجا هیچ‌وقت باز نمی‌شود: مقصد فقط از فیلد SNI در ClientHello خوانده
# می‌شود و کانکشن دست‌نخورده forward می‌شود.
#
#   SNI = دامنه‌های میرور        → کانتینر nginx خود میرور (شبکه‌ی داکر)
#   SNI = هر چیز دیگر           → همان هاست روی ۴۴۳ در اینترنت
#
# ⚠️ خط مربوط به دامنه‌های میرور حیاتی است. بدون آن، SNI برابر
#    mirror.<domain> به DNS عمومی می‌رود، به IP همین سرور می‌رسد، و پروکسی
#    به خودش وصل می‌شود — یک درخواست کل worker_connections را می‌خورد و
#    پروکسی برای همه‌ی کلاینت‌ها می‌خوابد (تست‌شده).
# ---------------------------------------------------------------------------
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid       /var/run/nginx.pid;

events {
    worker_connections 8192;
}

stream {
    # 127.0.0.11 = DNS داخلی داکر. هم اسم سرویس‌های همین compose را حل
    # می‌کند (nginx) و هم بقیه را به DNS بالادست (گزینه‌ی dns: در compose)
    # فوروارد می‌کند. با یک resolver عمومی مثل 1.1.1.1، اسم کانتینر حل
    # نمی‌شد و مسیر میرور می‌شکست.
    resolver         127.0.0.11 ipv6=off valid=30s;
    resolver_timeout 5s;

    map $ssl_preread_server_name $https_destination {
        ""                       127.0.0.1:9;   # بدون SNI → جایی که کسی گوش نمی‌دهد
        ${MIRROR_DOMAIN}         nginx:443;
        docker.${MIRROR_DOMAIN}  nginx:443;
        push.${MIRROR_DOMAIN}    nginx:443;
        default                  $ssl_preread_server_name:443;
    }

    log_format sni_https
        '$remote_addr [$time_local] '
        'sni="$ssl_preread_server_name" '
        'status=$status sent=$bytes_sent received=$bytes_received '
        'time=$session_time';

    server {
        listen 0.0.0.0:443 reuseport;

        # لیست کلاینت‌های مجاز؛ پنل (/panel/ips) می‌سازدش. پیش‌فرض «همه
        # ممنوع» است — بدون IP هیچ‌کس رد نمی‌شود، نه میرور نه passthrough.
        include /etc/nginx/sni-allow.conf;

        ssl_preread on;

        proxy_connect_timeout 15s;
        proxy_timeout         30m;
        proxy_pass            $https_destination;

        access_log /var/log/nginx/sni-access.log sni_https;
        error_log  /var/log/nginx/sni-error.log warn;
    }
}
