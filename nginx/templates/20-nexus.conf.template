# ---------------------------------------------------------------------------
# ورودی اصلی میرور.
#
#   mirror.<domain>   → Nexus روی 8081  (UI + همه‌ی /repository/... ها)
#   docker.<domain>   → کانکتور docker-group روی 5000 (pull)
#
# متغیر ${MIRROR_DOMAIN} را entrypoint خود ایمیج nginx با envsubst پر می‌کند.
# فیلتر NGINX_ENVSUBST_FILTER=MIRROR_ در compose ست شده، پس متغیرهای خود
# nginx مثل $host و $remote_addr دست‌نخورده می‌مانند.
#
# $mirror_denied در 00-acl.conf (همان nginx/acl.conf) تعریف شده.
# زون کش و زون‌های سهمیه در 10-cache.conf تعریف شده‌اند.
#
# ─── درباره‌ی locationهای زیاد ───────────────────────────────────────────────
# هر آدرسی که «تغییرناپذیر» باشد (محتوایش تابع محضِ URL است) در nginx کش
# می‌شود تا درخواست دومش اصلاً به نکسس نرسد — هم بار JVM کم می‌شود، هم زیر
# سقف ۱۰۰٬۰۰۰ درخواست در روزِ Community Edition می‌مانی. متادیتاها (ایندکس
# apt، صفحه‌ی simple پایتون، packument نpm، @v/list گو، محتوای شاخه‌ی گیت‌هاب)
# عمداً کش نمی‌شوند، چون زیر همان آدرس عوض می‌شوند.
#
# ترتیب locationهای regex مهم است: nginx به ترتیبِ نوشته‌شدن چک می‌کند و
# اولین تطابق برنده است. پس همه‌ی استثناهای «کش نکن» قبل از قاعده‌ی کلیِ
# پسوندها می‌آیند.
# ---------------------------------------------------------------------------

# ---------- HTTP: فقط ACME و ریدایرکت ----------
server {
    listen      80;
    server_name ${MIRROR_DOMAIN} docker.${MIRROR_DOMAIN} push.${MIRROR_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- Nexus: UI و همه‌ی فرمت‌ها (pypi / npm / go / apt / raw) ----------
server {
    listen      443 ssl;
    http2 on;
    server_name ${MIRROR_DOMAIN};

    include /etc/nginx/conf.d/90-ssl.inc;

    # allowlist؛ پیش‌فرض همه را رد می‌کند تا IP خودت را اضافه کنی.
    # $mirror_block (در 10-cache.conf) همان $mirror_denied است، به‌علاوه‌ی
    # استثنای پنل وقتی MIRROR_PANEL_OPEN=1 باشد.
    if ($mirror_block) { return 403; }

    # اگر IP ثابت نداری، به‌جای allowlist این دو خط را باز کن و
    # htpasswd را در nginx/ بساز و در compose مانتش کن:
    #   docker run --rm httpd:alpine htpasswd -nb user pass >> nginx/htpasswd
    # auth_basic           "mirror";
    # auth_basic_user_file /etc/nginx/conf.d/htpasswd;

    # لاگ با ستون cache=HIT/MISS/... — برای اندازه‌گیری hit ratio لازم است.
    access_log /var/log/nginx/access.log mirror;

    # سهمیه‌ی هر IP. جلوی یک کلاینتِ گیرکرده در حلقه‌ی retry را می‌گیرد تا
    # سهمیه‌ی روزانه‌ی مشترک را نسوزاند. اعداد در .env قابل تنظیم‌اند.
    limit_req  zone=mirror_rate burst=${MIRROR_RATE_BURST} nodelay;
    limit_conn mirror_conns ${MIRROR_CONN_LIMIT};

    # آپلود پکیج (twine / npm publish / curl --upload-file) سقف حجم ندارد.
    # همین به location /panel هم ارث می‌رسد (آپلود از پنل هم لازمش دارد).
    client_max_body_size 0;

    # proxy_pass با هاست‌نیم لفظی فقط یک‌بار، در لحظه‌ی بالا آمدن/reload
    # نگین‌اکس، resolve می‌شود. اگر همان لحظه nexus بالا نباشد، کل nginx
    # (و مسیر ACME روی پورت ۸۰) با «host not found in upstream» بالا
    # نمی‌آید؛ و بعداً هم آی‌پی را برای همیشه کش می‌کند و با recreate شدن
    # کانتینر nexus (مثلاً موقع آپگرید) ۵۰۲ دائمی می‌دهد. با resolver +
    # متغیر، resolve هر بار در زمان درخواست انجام می‌شود. اینجا در سطح
    # server تعریف شده تا همه‌ی locationها از آن استفاده کنند.
    resolver 127.0.0.11 valid=10s;
    set $nexus_upstream nexus:8081;
    set $panel_upstream panel:3000;

    # پنل مدیریت (IP allowlist + پکیج‌ها). عمداً بدون / آخر: Next.js با
    # basePath="/panel" ریشه‌ی اپ را به‌جای «/panel/» با «/panel» (بدون
    # اسلش) canonical می‌کند؛ اگر پترن اینجا «/panel/» بود، درخواست به
    # «/panel» با آن مچ نمی‌شد و می‌افتاد روی location / (یعنی نکسس) —
    # نتیجه‌اش یک ریدایرکت loop بی‌نهایت بین پنل و نکسس بود. این پترن هم
    # «/panel» و هم هر چیزی زیر «/panel/...» را می‌گیرد.
    #
    # ^~ یعنی اگر این prefix برنده شد، دیگر سراغ locationهای regex نرو —
    # هیچ‌کدام از قواعد کش نباید به دارایی‌های استاتیک پنل دست بزنند.
    # auth پنل جدا از همین allowlist است (لاگین با یوزر/پس ادمین Nexus).
    # صفحه‌ی لاگین سهمیه‌ی خیلی سخت‌گیرانه‌تری دارد، چون با
    # MIRROR_PANEL_OPEN=1 از اینترنت باز است و تنها چیزی که پشتش می‌ماند رمز
    # ادمین نکسس است. «=» یعنی تطابق دقیق، پس فقط خود این آدرس را می‌گیرد و
    # دارایی‌های /panel/_next/... با این سهمیه درگیر نمی‌شوند.
    location = /panel/login {
        limit_req zone=panel_login burst=${MIRROR_PANEL_LOGIN_BURST} nodelay;
        proxy_pass http://$panel_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        proxy_buffering off;
    }

    location ^~ /panel {
        proxy_pass http://$panel_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        proxy_buffering off;
    }

    # --- apt: ایندکس‌های by-hash ------------------------------------------
    # مسیرشان خودِ هشِ محتواست، پس تغییرناپذیرند. اوبونتو/دبیان به‌صورت
    # پیش‌فرض همین‌ها را می‌گیرند، و `apt update` روی چند سرور دقیقاً همین
    # فایل‌ها را تکرار می‌کند.
    location ~ /dists/.+/by-hash/ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        include /etc/nginx/conf.d/92-cache.inc;
        proxy_cache_valid 200 ${MIRROR_IMMUTABLE_TTL};
    }

    # --- apt: بقیه‌ی dists ------------------------------------------------
    # InRelease / Release / Packages: کش نمی‌کنیم. اگر Release کش‌شده با
    # Packages تازه نخواند، apt با «Hash Sum mismatch» می‌ترکد.
    location ~ /dists/ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        proxy_buffering off;
    }

    # --- go: فهرست نسخه‌ها و @latest --------------------------------------
    # با انتشار هر نسخه‌ی جدید عوض می‌شوند.
    location ~ (/@v/list|/@latest)$ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        proxy_buffering off;
    }

    # --- go: یک نسخه‌ی مشخص ------------------------------------------------
    # .info / .mod / .zip یک نسخه‌ی منتشرشده هرگز عوض نمی‌شوند (خود go با
    # GOSUMDB همین را تضمین می‌کند).
    location ~ /@v/[^/]+\.(info|mod|zip)$ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        include /etc/nginx/conf.d/92-cache.inc;
        proxy_cache_valid 200 ${MIRROR_IMMUTABLE_TTL};
    }

    # --- pypi: صفحه‌ی simple ----------------------------------------------
    # فهرست فایل‌های یک پکیج است؛ با هر انتشار جدید عوض می‌شود.
    location ~ ^/repository/[^/]+/simple/ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        proxy_buffering off;
    }

    # --- گیت‌هاب: محتوای شاخه ---------------------------------------------
    # raw.githubusercontent.com و آرشیو یک شاخه (archive/refs/heads/x.tar.gz)
    # زیر همان آدرس عوض می‌شوند — برخلاف فایل‌های ریلیز که تغییرناپذیرند.
    location ~ ^/repository/raw-ghusercontent/|/archive/refs/heads/ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        proxy_buffering off;
    }

    # --- آرشیوها و پکیج‌های نسخه‌دار ---------------------------------------
    # wheel، sdist، tarball نpm، .deb، .rpm، jar، crate، فایل ریلیز گیت‌هاب…
    # همه زیر آدرس نسخه‌دار می‌آیند و بازنویسی نمی‌شوند (خود نکسس هم اجازه‌ی
    # بازنویسی نسخه را نمی‌دهد — PACKAGES.md).
    location ~* ^/repository/.+\.(whl|egg|tar|tgz|txz|tbz2|gz|bz2|xz|zst|zip|7z|deb|udeb|ddeb|rpm|apk|jar|war|ear|aar|pom|module|gem|crate|nupkg|exe|msi|dmg|pkg|asc|sig|sha256|sha512)$ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        include /etc/nginx/conf.d/92-cache.inc;
        proxy_cache_valid 200 ${MIRROR_IMMUTABLE_TTL};
    }

    # --- بقیه: UI، REST API، متادیتای npm و هر چیز دیگر --------------------
    location / {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        proxy_buffering off;
    }
}

# ---------- Docker pull: کانکتور docker-group روی 5000 ----------
server {
    listen      443 ssl;
    http2 on;
    server_name docker.${MIRROR_DOMAIN};

    include /etc/nginx/conf.d/90-ssl.inc;

    # ⚠️ داکر برای registry-mirrors هیچ Basic Auth ای نمی‌فرستد،
    #    پس روی این هاست فقط IP allowlist کار می‌کند.
    if ($mirror_denied) { return 403; }

    access_log /var/log/nginx/access.log mirror;

    limit_req  zone=mirror_rate burst=${MIRROR_RATE_BURST} nodelay;
    limit_conn mirror_conns ${MIRROR_CONN_LIMIT};

    client_max_body_size 0;
    chunked_transfer_encoding on;

    resolver 127.0.0.11 valid=10s;
    set $nexus_upstream nexus:5000;

    # --- ping ---------------------------------------------------------------
    # داکر قبل از هر pull یک بار /v2/ را می‌زند. پاسخش عملاً ثابت است ولی
    # در سهمیه‌ی روزانه شمرده می‌شود؛ کش کوتاه‌مدتش یک درخواست به ازای هر
    # pull صرفه‌جویی می‌کند.
    location = /v2/ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        include /etc/nginx/conf.d/92-cache.inc;
        proxy_cache_valid 200 ${MIRROR_DOCKER_PING_TTL};
    }

    # --- لایه‌ها ------------------------------------------------------------
    # آدرسشان خودِ هشِ محتواست. تغییرناپذیرترین چیزِ ممکن، و بیشترِ حجم و
    # بیشترِ تعداد درخواست‌های یک pull هم همین‌هاست.
    location ~ ^/v2/.+/blobs/[a-z0-9]+:[A-Fa-f0-9]+$ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        include /etc/nginx/conf.d/92-cache.inc;
        proxy_cache_valid 200 ${MIRROR_IMMUTABLE_TTL};
    }

    # --- manifest با digest -------------------------------------------------
    location ~ ^/v2/.+/manifests/[a-z0-9]+:[A-Fa-f0-9]+$ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        include /etc/nginx/conf.d/92-cache.inc;
        proxy_cache_valid 200 ${MIRROR_IMMUTABLE_TTL};
    }

    # --- manifest با تگ -----------------------------------------------------
    # تگ جابه‌جا می‌شود (`latest` که مثال بارزش است)، پس TTL کوتاه. حتی چند
    # دقیقه، در یک بیلد موازی ده‌ها درخواست را حذف می‌کند. اگر می‌خواهی
    # کاملاً تازه باشد، MIRROR_DOCKER_TAG_TTL را در .env بگذار 1s.
    location ~ ^/v2/.+/manifests/ {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        include /etc/nginx/conf.d/92-cache.inc;
        proxy_cache_valid 200 ${MIRROR_DOCKER_TAG_TTL};
    }

    # --- بقیه: tags/list، catalog، مسیرهای آپلود ---------------------------
    location / {
        proxy_pass http://$nexus_upstream;
        include /etc/nginx/conf.d/91-proxy.inc;
        proxy_buffering         off;
        proxy_request_buffering off;
    }
}
