# ---------------------------------------------------------------------------
# لایه‌ی کش و سهمیه‌بندی، جلوی Nexus.
#
# چرا اصلاً لازم است؟
#   از نسخه‌ی 3.77 به بعد نسخه‌ی رایگان نکسس «Community Edition» است و دو سقف
#   سخت دارد:
#     • ۴۰٬۰۰۰ کامپوننت
#     • ۱۰۰٬۰۰۰ درخواست در روز به مسیرهای /repository*/
#   «درخواست» یعنی هر HTTP ای که به ریپو بخورد — دانلود، آپلود، خواندن
#   متادیتا، حتی درخواست‌های ناموفق. یک `docker pull` تنها، ده‌ها درخواست
#   است (ping + manifest + یک blob به ازای هر لایه). یک `npm ci` صدها تا.
#   نتیجه: تا میرور را با چند سرور یا چند تیم share می‌کنی، سقف روزانه خیلی
#   زودتر از انتظار پر می‌شود و نکسس افزودن کامپوننت جدید را می‌بندد — یعنی
#   هرچه از قبل کش نشده دیگر نمی‌آید.
#
# راهکار: هر چیزی که «تغییرناپذیر» است — یعنی محتوایش تابع محضِ آدرسش است،
# مثل لایه‌های داکر (sha256)، wheel، tarball، .deb، zip ماژول گو — را همین‌جا
# در nginx کش می‌کنیم. درخواست دومِ همان فایل اصلاً به نکسس نمی‌رسد، پس
# نه در شمارش روزانه می‌آید و نه JVM را درگیر می‌کند. روی یک میرور مشترک که
# چند سرور ایمیج‌های پایه‌ی مشابه می‌کشند، بیشترِ ترافیک دقیقاً همین است.
#
# آنچه اینجا حل *نمی‌شود*: سقف ۴۰٬۰۰۰ کامپوننت. آن را باید با Cleanup Policy
# در خود نکسس نگه داشت (توضیح در DEPLOY.md، بخش «سقف‌های Community Edition»).
#
# مقدارهای ${MIRROR_*} را docker-compose.yml ست می‌کند. توجه: envsubst ایمیج
# nginx نحو ${VAR:-default} را نمی‌فهمد، پس هیچ‌کدام اینجا default ندارند و
# باید در compose تعریف شده باشند، وگرنه لفظی باقی می‌مانند و nginx بالا
# نمی‌آید.
# ---------------------------------------------------------------------------

proxy_cache_path /var/cache/mirror/cache
                 levels=1:2
                 keys_zone=mirror_cache:${MIRROR_CACHE_KEYS_ZONE}
                 max_size=${MIRROR_CACHE_MAX_SIZE}
                 inactive=${MIRROR_CACHE_INACTIVE}
                 use_temp_path=off;

# ---------------------------------------------------------------------------
# کلید کش
#
# پیش‌فرض nginx ($scheme$proxy_host$request_uri) کافی است، ولی یک مورد خاص
# دارد: پاسخِ manifest داکر به هدر Accept کلاینت بستگی دارد — داکر و
# containerd و پادمن لیست مدیاتایپ متفاوتی می‌فرستند و رجیستری بسته به آن
# manifest list یا manifest تک‌پلتفرمی برمی‌گرداند. اگر Accept در کلید نباشد،
# پاسخ کش‌شده برای یک کلاینت به کلاینت دیگر داده می‌شود و pull می‌شکند.
#
# برای بقیه‌ی مسیرها Accept را عمداً در کلید نمی‌آوریم، وگرنه کش بی‌دلیل
# تکه‌تکه می‌شود (هر ابزاری Accept خودش را می‌فرستد ولی فایل یکی است).
# ---------------------------------------------------------------------------
map $uri $mirror_cache_vary {
    default                 "";
    ~^/v2/.+/manifests/     $http_accept;
}

# ---------------------------------------------------------------------------
# سهمیه‌ی هر کلاینت.
#
# این سقف روزانه‌ی نکسس را «اعمال» نمی‌کند (۱۰۰هزار در روز یعنی ۱.۲ درخواست
# در ثانیه — عملاً غیرقابل زندگی). کارش این است که یک کلاینت خراب یا حلقه‌ی
# retry ای که گیر کرده، سهمیه‌ی مشترک بقیه را در چند دقیقه نسوزاند.
# پیش‌فرض‌ها آن‌قدر بالا هستند که استفاده‌ی عادی (حتی CI موازی) به آن نخورد؛
# اگر خوردی، MIRROR_RATE_LIMIT و MIRROR_RATE_BURST را در .env ببر بالا.
#
# nodelay یعنی درخواست‌های داخل burst بی‌درنگ سرو می‌شوند (فقط شمرده
# می‌شوند) — برای میرور بهتر از صف کردن است، چون CI طبیعتاً انفجاری است.
# ---------------------------------------------------------------------------
limit_req_zone  $binary_remote_addr zone=mirror_rate:10m rate=${MIRROR_RATE_LIMIT};
limit_conn_zone $binary_remote_addr zone=mirror_conns:10m;

# سهمیه‌ی جداگانه و خیلی سخت‌گیرانه‌تر برای صفحه‌ی لاگین پنل. پنل می‌تواند
# بدون allowlist از اینترنت باز باشد (پایین توضیح داده شده)، و آن‌وقت تنها
# چیزی که پشتش ایستاده رمز ادمین نکسس است — پس نرخ تلاش باید محدود باشد.
# فقط روی خودِ /panel/login است، نه دارایی‌های استاتیک، وگرنه یک بار لود شدن
# صفحه سهمیه را تمام می‌کرد.
limit_req_zone  $binary_remote_addr zone=panel_login:10m rate=${MIRROR_PANEL_LOGIN_RATE};

# ---------------------------------------------------------------------------
# چه کسی 403 بگیرد.
#
# پیش‌فرض: هر IP ای که در acl.conf نیست. اما پنل استثناست — با
# MIRROR_PANEL_OPEN=1 از اینترنت برای همه باز می‌شود، بدون اینکه مخازن باز
# شوند. دلیلش عملی است: IP خانگی/VPN مدام عوض می‌شود و آدم را از پنل خودش
# بیرون می‌گذارد، درحالی‌که پنل خودش لاگین دارد (یوزر/پس ادمین نکسس) ولی
# مخازن ندارند.
#
# ⚠️ این استثنا فقط روی اتصال‌های مستقیم به nginx معنی دارد. ترافیکی که از
#    sniproxy می‌آید $remote_addr اش خودِ پروکسی است، پس geo آنجا چیزی را
#    تفکیک نمی‌کند — گیت واقعی همان sni-allow.conf است. برای همین وقتی
#    پروکسی SNI روشن است، پنلِ باز را باید روی پورت مستقیم nginx صدا زد
#    (MIRROR_HTTPS_BIND=0.0.0.0:8443)، نه از ۴۴۳.
# ---------------------------------------------------------------------------
map $uri $mirror_is_panel {
    default   0;
    ~^/panel  1;
}

# مقدار ثابتِ .env را به یک متغیر nginx تبدیل می‌کند. کلید map باید فقط از
# متغیر ساخته شود، پس نمی‌شود ${MIRROR_PANEL_OPEN} را مستقیم داخل کلید بعدی
# گذاشت؛ این map با تنها یک default همان کار را می‌کند.
map $host $mirror_panel_open {
    default ${MIRROR_PANEL_OPEN};
}

# کلید: "<پنلِ باز><آیا پنل است><آیا IP ممنوع است>"
map $mirror_panel_open$mirror_is_panel$mirror_denied $mirror_block {
    default   0;
    "001"     1;   # پنلِ باز خاموش → همه‌چیز، از جمله پنل، allowlist می‌خواهد
    "011"     1;
    "101"     1;   # پنلِ باز روشن → فقط غیرِ پنل بلاک می‌شود
}

# ---------------------------------------------------------------------------
# ریشه، برای کسی که اجازه‌ی مخازن ندارد
#
# «/» نه مخزن است نه پنل — UI خود نکسس آنجاست. پس کلاینتی که در allowlist
# نیست و فقط دامنه را در مرورگر تایپ کرده، یک ۴۰۳ خالیِ nginx می‌گیرد بدون
# هیچ سرنخی. تنها چیزی که واقعاً دنبالش بوده پنل است، پس بفرستش همان‌جا.
#
# هر سه شرط لازم است — پنلِ باز روشن، IP ممنوع، و آدرس دقیقاً «/»:
#   • اگر پنلِ باز خاموش باشد، ریدایرکت فقط او را به یک ۴۰۳ دیگر می‌رساند.
#   • اگر IP مجاز باشد نباید ریدایرکت شود؛ او دارد UI نکسس را می‌خواهد
#     (تنظیم Base URL، Cleanup Policy، عوض کردن رمز ادمین — همه آنجاست).
#   • فقط «/» دقیق، نه هر مسیر دیگری: مخازن باید ۴۰۳ بمانند، نه اینکه با
#     ریدایرکت وجود یا نبودشان لو برود.
#
# ⚠️ ۳۰۲ و نه ۳۰۱/۳۰۸. ریدایرکت دائمی را مرورگر برای همیشه کش می‌کند، و اگر
#    بعداً IP همین آدم مجاز شود دیگر هیچ‌وقت UI نکسس را نمی‌بیند.
# ---------------------------------------------------------------------------
map $uri $mirror_is_root {
    default 0;
    "/"     1;
}

# کلید: "<پنلِ باز><آیا IP ممنوع است><آیا ریشه است>"
map $mirror_panel_open$mirror_denied$mirror_is_root $mirror_root_to_panel {
    default 0;
    "111"   1;
}

# 429 گویاتر از 503 پیش‌فرض است و کلاینت‌ها (داکر، pip، npm) با آن backoff
# می‌کنند به‌جای اینکه خطای سرور فرض کنند.
limit_req_status  429;
limit_conn_status 429;

# ---------------------------------------------------------------------------
# لاگ با وضعیت کش — بدون این نمی‌شود فهمید hit ratio چقدر است و آیا واقعاً
# داری زیر سقف روزانه می‌مانی یا نه. طرز خواندنش در DEPLOY.md.
# ---------------------------------------------------------------------------
log_format mirror '$remote_addr $host "$request" $status $body_bytes_sent '
                  'cache=$upstream_cache_status rt=$request_time';
