# ---------------------------------------------------------------------------
# این فایل عمداً روی /etc/nginx/conf.d/default.conf ایمیج رسمی nginx نوشته
# می‌شود تا صفحه‌ی «Welcome to nginx» و default_server آن حذف شود.
#
# اینجا فقط یک catch-all می‌گذاریم: هر درخواستی که Host اش با هیچ‌کدام از
# server_name های ما جور نباشد، بی‌جواب بسته می‌شود (444). این جلوی
# اسکن‌های کور روی IP سرور را می‌گیرد.
# ---------------------------------------------------------------------------

server {
    listen      80 default_server;
    server_name _;

    # ACME حتی برای Host ناشناس هم باید کار کند، وگرنه صدور گواهی
    # در بوت اول (که هنوز DNS ممکن است کامل پخش نشده باشد) گیر می‌کند.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / { return 444; }
}

# بدون این، یک درخواست HTTPS به آی‌پی خام یا بدون SNI به اولین server block
# روی 443 می‌افتد — یعنی vhost اصلی Nexus (ACL همچنان اعمال می‌شود، پس این
# یک باگ امنیتی نیست، ولی سرور را با هیچ Host شناخته‌شده‌ای هم پاسخ‌گو
# نگه می‌دارد که لازم نیست).
server {
    listen      443 ssl default_server;
    http2 on;
    server_name _;

    include /etc/nginx/conf.d/90-ssl.inc;

    return 444;
}
