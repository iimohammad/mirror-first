# ---------------------------------------------------------------------------
# تنظیمات مشترک کش. فقط داخل locationهایی include می‌شود که آدرسشان
# «تغییرناپذیر» است — یعنی محتوا تابع محضِ URL است و هیچ‌وقت زیر همان آدرس
# عوض نمی‌شود (لایه‌ی داکر با sha256، wheel، tarball، .deb، zip ماژول گو).
#
# مدت اعتبار (proxy_cache_valid 200) عمداً اینجا نیست؛ هر location خودش
# می‌گذارد، چون manifest با تگ باید TTL کوتاه داشته باشد و بقیه بلند.
#
# ⚠️ یک فرض صریح: این کش به Authorization کاری ندارد. یعنی اگر کلاینت A یک
#    فایل را بیاورد، کلاینت B همان فایل را از کش می‌گیرد بدون اینکه نکسس
#    دوباره مجوزش را چک کند. در این چیدمان درست است، چون همه‌ی ریپوهای
#    proxy با دسترسی ناشناس خوانده می‌شوند (اصلاً registry-mirrors داکر
#    بدون آن کار نمی‌کند) و مرزِ اعتماد، همان allowlist آی‌پی در 00-acl.conf
#    است. اگر روزی ریپویی ساختی که فقط بعضی کاربران باید ببینندش، این کش را
#    برای آن مسیر خاموش کن (یا proxy_cache_bypass $http_authorization اضافه
#    کن) وگرنه از کش لو می‌رود.
# ---------------------------------------------------------------------------

proxy_cache     mirror_cache;
proxy_cache_key "$host$uri$mirror_cache_vary";

# بدون بافر شدن پاسخ، nginx نمی‌تواند همزمان به کلاینت بدهد و در کش بنویسد.
# فایل موقت داخل خود دایرکتوری کش ساخته می‌شود (use_temp_path=off)، پس
# انتقالِ نهایی یک rename ساده است و دانلود لایه‌های چندصد مگابایتی هم
# استریم می‌ماند (کلاینت منتظر تمام شدن دانلود نمی‌ماند).
proxy_buffering on;

# --- صرفه‌جویی در درخواستِ upstream ---------------------------------------

# مهم‌ترین خط برای میرورِ مشترک: وقتی ده سرور همزمان همان لایه‌ای را می‌خواهند
# که هنوز کش نشده، فقط یکی به نکسس می‌رود و بقیه منتظر همان می‌مانند.
# بدون این، هر ده تا جدا جدا شمرده می‌شوند.
proxy_cache_lock          on;
proxy_cache_lock_age      60s;
proxy_cache_lock_timeout  300s;

# اگر نکسس خوابیده یا سهمیه‌اش تمام شده (429)، نسخه‌ی کش‌شده را — حتی
# منقضی — بده به‌جای اینکه بیلد بشکند.
proxy_cache_use_stale error timeout updating
                      http_429 http_500 http_502 http_503 http_504;
proxy_cache_background_update on;

# روی entry منقضی به‌جای دانلود دوباره، If-None-Match/If-Modified-Since
# می‌فرستد؛ ۳۰۴ هم یک درخواست است ولی بایت جابه‌جا نمی‌شود.
proxy_cache_revalidate on;

# پاسخ منفی را کوتاه‌مدت نگه می‌داریم. یک کلاینت خرابِ در حال retry روی
# پکیجی که وجود ندارد، در نسخه‌ی Community هم سهمیه می‌سوزاند — درخواست
# ناموفق هم شمرده می‌شود.
proxy_cache_valid 404 ${MIRROR_NEGATIVE_TTL};

# --- بهداشت ---------------------------------------------------------------

# نکسس روی بعضی پاسخ‌ها JSESSIONID ست می‌کند. اگر کش شود، سشن یک کلاینت به
# بقیه داده می‌شود؛ پس هم نادیده‌اش می‌گیریم هم از پاسخ حذفش می‌کنیم.
proxy_ignore_headers Cache-Control Expires Set-Cookie X-Accel-Expires Vary;
proxy_hide_header    Set-Cookie;

# add_header در سطح location، هدرهای ارث‌رسیده از server را پاک می‌کند —
# پس HSTS ای که 90-ssl.inc گذاشته باید اینجا دوباره بیاید.
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Mirror-Cache            $upstream_cache_status always;
