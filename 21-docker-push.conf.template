# ---------------------------------------------------------------------------
# کانکتور push داکر (ریپوی docker-hosted روی پورت ۵۰۰۱).
# push به ریپوی group کار نمی‌کند، برای همین هاست‌نیم جداست.
# pull از همان docker.<domain> انجام می‌شود چون hosted عضو group است.
#
# ⚠️ بعد از فعال کردن این فایل، گواهی را دوباره صادر کن:
#   docker compose run --rm --entrypoint certbot certbot certonly \
#     --webroot -w /var/www/certbot --expand \
#     -d <domain> -d docker.<domain> -d push.<domain> \
#     --email <email> --agree-tos -n
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name push.${MIRROR_DOMAIN};

    include /etc/nginx/conf.d/90-ssl.inc;
    if ($mirror_denied) { return 403; }

    chunked_transfer_encoding on;

    location / {
        proxy_pass http://nexus:5001;
    }
}
