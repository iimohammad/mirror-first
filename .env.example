# دامنه‌ی اصلی میرور. باید رکورد A داشته باشد به IP همین سرور.
# همچنین docker.<MIRROR_DOMAIN> هم باید رکورد A داشته باشد.
MIRROR_DOMAIN=mirror.example.com

# ایمیل برای Let's Encrypt
LETSENCRYPT_EMAIL=you@example.com

# ساب‌دامین‌های اضافه روی همان گواهی، با فاصله از هم جدا.
# اگر می‌خواهی docker push هم داشته باشی، push.<domain> را اینجا بگذار.
# CERT_EXTRA_DOMAINS=push.mirror.example.com

# نسخه‌ی Nexus (آخرین تگ پایدار را چک کن)
NEXUS_VERSION=3.70.1

# اکانت داکرهاب — سقف pull ناشناس ۱۰۰ تا در ۶ ساعت است؛ با اکانت رایگان ۲۰۰ تا.
# توکن را از hub.docker.com > Account Settings > Personal access tokens بگیر.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
