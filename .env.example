# دامنه‌ی اصلی میرور. باید رکورد A داشته باشد به IP همین سرور.
# همچنین docker.<MIRROR_DOMAIN> هم باید رکورد A داشته باشد.
MIRROR_DOMAIN=mirror.example.com

# ایمیل برای Let's Encrypt
LETSENCRYPT_EMAIL=you@example.com

# ساب‌دامین‌های اضافه روی همان گواهی، با فاصله از هم جدا.
# اگر می‌خواهی docker push هم داشته باشی، push.<domain> را اینجا بگذار.
# CERT_EXTRA_DOMAINS=push.mirror.example.com

# نسخه‌ی Nexus (آخرین تگ پایدار را چک کن)
NEXUS_VERSION=3.70.1

# روی سرور کمتر از ۸ گیگ، این دو را متناسب کم کن (پیش‌فرض docker-compose.yml
# برای ۸ گیگ کالیبره شده). مثلاً برای سرور ۴ گیگ:
# NEXUS_JVM_ARGS=-Xms1200m -Xmx1200m -XX:MaxDirectMemorySize=1200m -Djava.util.prefs.userRoot=/nexus-data/javaprefs
# NEXUS_MEM_LIMIT=3g

# اکانت داکرهاب — سقف pull ناشناس ۱۰۰ تا در ۶ ساعت است؛ با اکانت رایگان ۲۰۰ تا.
# توکن را از hub.docker.com > Account Settings > Personal access tokens بگیر.
#
# ⚠️ وقتی میرور را share می‌کنی، این سقف بین *همه* تقسیم می‌شود: از دید داکرهاب
#    فقط یک آی‌پی و یک اکانت وجود دارد. آنچه از سهمیه کم می‌کند فقط pull هایی
#    است که در نکسس کش نشده‌اند (ایمیج تکراری دوباره از داکرهاب نمی‌آید)، ولی با
#    چند تیم و ایمیج‌های متنوع، ۲۰۰ تا در ۶ ساعت زود تمام می‌شود.
#    اکانت Pro/Team/Business سقف pull ندارد و ساده‌ترین راه‌حل همین است.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# ---------------------------------------------------------------------------
# کش nginx جلوی نکسس
#
# چرا: نکسس ۳.۷۷ به بعد Community Edition است و روزی ۱۰۰٬۰۰۰ درخواست به
# /repository*/ بیشتر نمی‌پذیرد (و ۴۰٬۰۰۰ کامپوننت). یک docker pull ده‌ها
# درخواست است. با کش کردن چیزهای تغییرناپذیر در nginx، تکرارها اصلاً به نکسس
# نمی‌رسند و در آن شمارش نمی‌آیند. جزئیات در DEPLOY.md.
#
# همه‌ی این‌ها پیش‌فرض دارند؛ فقط چیزی را که می‌خواهی عوض کنی از کامنت دربیاور.
# ---------------------------------------------------------------------------

# سقف حجم کش. این *علاوه بر* nexus_data روی همان دیسک می‌نشیند (نسخه‌ی دوم
# آرتیفکت‌های داغ)، پس روی دیسک ۱۰۰ گیگ بیشتر از ۲۰ گیگ نده.
# MIRROR_CACHE_MAX_SIZE=20g

# هر چیزی که این مدت دست نخورد از کش حذف می‌شود.
# MIRROR_CACHE_INACTIVE=30d

# مدت اعتبار آرتیفکت‌های تغییرناپذیر (لایه‌ی داکر، wheel، .deb، zip گو…).
# MIRROR_IMMUTABLE_TTL=365d

# manifest داکر وقتی با تگ خواسته شود (مثل :latest) — تگ جابه‌جا می‌شود، پس
# کوتاه. اگر می‌خواهی هیچ تأخیری در دیدن تگ تازه نباشد بگذار 1s.
# MIRROR_DOCKER_TAG_TTL=1m

# پاسخ /v2/ که داکر قبل از هر pull می‌زند.
# MIRROR_DOCKER_PING_TTL=5m

# ۴۰۴ کوتاه‌مدت کش می‌شود تا کلاینتی که در حلقه‌ی retry روی پکیج ناموجود گیر
# کرده سهمیه نسوزاند (درخواست ناموفق هم در سقف نکسس شمرده می‌شود).
# MIRROR_NEGATIVE_TTL=1m

# اندازه‌ی زون کلیدهای کش. هر ۱ مگابایت حدود ۸۰۰۰ کلید.
# MIRROR_CACHE_KEYS_ZONE=64m

# ---------------------------------------------------------------------------
# سهمیه‌ی هر آی‌پی
#
# سقف روزانه‌ی نکسس را اعمال نمی‌کند؛ فقط جلوی یک کلاینت خراب را می‌گیرد که
# سهمیه‌ی مشترک بقیه را نسوزاند. پیش‌فرض‌ها برای CI موازی هم راحت‌اند. اگر
# ۴۲۹ گرفتی، ببرشان بالا.
# ---------------------------------------------------------------------------
# MIRROR_RATE_LIMIT=100r/s
# MIRROR_RATE_BURST=500
# MIRROR_CONN_LIMIT=200

# کلید رمزنگاری سشن پنل (/panel/) — با این بساز، هیچ‌جای دیگر استفاده‌اش نکن:
#   openssl rand -hex 32
# اگر عوض شود همه باید دوباره لاگین کنند؛ چیزی خراب نمی‌شود.
PANEL_SESSION_SECRET=

# ---------------------------------------------------------------------------
# پروکسی SNI (اختیاری) — برای کارهایی که میرور نمی‌تواند: git clone روی
# HTTPS، دانلود از گیت‌هاب، هر هاست HTTPS دیگر.
#
# برای روشن کردنش هر دو خط زیر را از کامنت دربیاور. هر دو با هم لازم‌اند:
# پروکسی صاحب ۴۴۳ می‌شود، پس nginx میرور باید از آن پورت کنار برود.
# COMPOSE_PROFILES=sni
# MIRROR_SNI=1
# MIRROR_HTTPS_BIND=127.0.0.1:8443
#
# اگر DNS شبکه‌ی سرور خارج مشکل دارد (پروکسی برای پیدا کردن مقصدِ SNI به آن
# نیاز دارد):
# SNI_DNS1=9.9.9.9
# SNI_DNS2=149.112.112.112

# ---------------------------------------------------------------------------
# پنلِ باز — وقتی IP خودت ثابت نیست (اینترنت خانگی، VPN) و مدام از پنل خودت
# بیرون می‌افتی.
#
# 1 یعنی مسیر /panel از allowlist مستثنا شود. مخازن (/repository/…) همچنان
# بسته می‌مانند — استثنا فقط برای پنل است، که خودش لاگین دارد (یوزر/پس ادمین
# نکسس) و صفحه‌ی لاگینش سهمیه‌ی سخت‌گیرانه می‌گیرد.
# MIRROR_PANEL_OPEN=1
#
# با روشن بودنش، کلاینتی که در allowlist نیست و فقط دامنه را باز می‌کند
# به‌جای یک ۴۰۳ خالی به /panel ریدایرکت می‌شود. کلاینت مجاز همچنان روی «/»
# همان UI نکسس را می‌بیند.
#
# با پروکسی SNI هم روی همان ۴۴۳ کار می‌کند (پورت جدا لازم نیست): پروکسی
# PROXY protocol می‌فرستد، پس nginx آی‌پی واقعی کلاینت را می‌بیند و خودش
# /panel را از /repository جدا می‌کند. فقط MIRROR_SNI=1 لازم است.
#
# سهمیه‌ی صفحه‌ی لاگین (پیش‌فرض ۲۰ در دقیقه با burst ۱۰):
# MIRROR_PANEL_LOGIN_RATE=20r/m
# MIRROR_PANEL_LOGIN_BURST=10
